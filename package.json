{
  "name": "docmonstakrakin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "wbs:render": "tsx scripts/renderWbs.ts",
    "wbs:check": "tsx scripts/renderWbs.ts --check",
    "qa": "tsx scripts/runAutomatedQa.ts",
    "test:remediation": "tsx scripts/testDiscoveryRemediation.ts",
    "test:tech": "tsx scripts/testTechnicalBaseline.ts",
    "test:cryptodemon": "tsx scripts/testCryptoDemon.ts && tsx scripts/testCryptoDemonIntegration.ts",
    "test:complete": "tsx scripts/runCompleteRegression.ts",
    "test": "npm run qa && npm run test:remediation && npm run test:tech && npm run test:cryptodemon && npm run test:proposal && npm run test:req-sync && npm run test:projects",
    "test:proposal": "tsx scripts/testProposalContract.ts",
    "test:req-sync": "tsx scripts/testRequirementStatusSync.ts",
    "test:projects": "tsx scripts/testProjectsWorkspace.ts",
    "test:bootstrap:contract": "tsx scripts/testSelfBootstrapContract.ts",
    "test:bootstrap:manifest": "tsx scripts/validateSelfBootstrapManifestFile.ts",
    "test:bootstrap:executor": "tsx scripts/testSelfBootstrapExecutor.ts",
    "test:bootstrap:execution-verifier": "tsx scripts/testSelfBootstrapExecutionVerifier.ts",
    "verify:bootstrap:execution": "tsx scripts/verifySelfBootstrapExecution.ts",
    "bootstrap:self": "tsx scripts/bootstrapSelf.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "yaml": "^2.9.1"
  }
}
