# Gemini API Key (server-side AI capability)
GEMINI_API_KEY=

# Server configuration
# Only IPv4 loopback is supported; wildcard/public binding is rejected.
HOST=127.0.0.1
# Integer 1..65535. Configuration is validated before credential initialization.
PORT=3000

# Normal application access: ENFORCED (default). No default identities.
# LOCAL_DEVELOPMENT explicitly selects the visibly unscoped legacy demo.
DMK_WORKSPACE_ACCESS=ENFORCED
# Optional paired fixed private loopback TLS paths; omit both for plain loopback.
# DMK_TLS_CERT=.security/tls/loopback.crt
# DMK_TLS_KEY=.security/tls/loopback.key

# Optional explicit master key for the encrypted local SecretStore.
# Do not commit real values.
DOCMONSTAKRAKIN_MASTER_KEY=

# LOCAL_DEVELOPMENT human reviewer roster JSON; not ENFORCED identity authority.
# Keep real reviewer credentials outside source control.
DMK_HUMAN_REVIEWERS=
