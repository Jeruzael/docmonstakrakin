# Gemini API Key (server-side AI capability)
GEMINI_API_KEY=

# Server configuration
# Only IPv4 loopback is supported; wildcard/public binding is rejected.
HOST=127.0.0.1
# Integer 1..65535. Configuration is validated before credential initialization.
PORT=3000

# Optional explicit master key for the encrypted local SecretStore.
# Do not commit real values.
DOCMONSTAKRAKIN_MASTER_KEY=

# Local human reviewer roster JSON.
# Keep real reviewer credentials outside source control.
DMK_HUMAN_REVIEWERS=
