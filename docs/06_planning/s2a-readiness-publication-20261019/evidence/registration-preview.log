      "parent_id": "EPIC-13",
      "title": "Local API Security Perimeter and Route Authorization",
      "description": "Classify all API routes and protect privileged endpoints; default local service to loopback unless secure network mode is explicitly configured.",
      "type": "SECURITY",
      "phase": "PHASE-12",
      "epic": "EPIC-13",
      "priority": "P0",
      "risk": "CRITICAL",
      "status": "PROPOSED",
      "dependencies": [
